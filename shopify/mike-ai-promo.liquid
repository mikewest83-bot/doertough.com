{% comment %}
  Doer Tough homepage — Mike AI promo (layout v2).
  Paste into a Custom liquid section. Hide/remove the DealTough block.
{% endcomment %}

<section class="dt-mike" id="dt-mike-promo" aria-labelledby="dt-mike-heading">
  <div class="dt-mike__inner">
    <div class="dt-mike__copy">
      <p class="dt-mike__eyebrow">Also from Doer Tough</p>
      <h2 class="dt-mike__heading" id="dt-mike-heading">Talk. Type.<span> Get the next move.</span></h2>
      <p class="dt-mike__body">Mike AI is the Doer Tough assistant. Voice or text — analyze a deal, find a flip, write it, or run the next money move. Same grit as the gear.</p>
      <ul class="dt-mike__list">
        <li>Analyze a used-item deal from a photo or a listing</li>
        <li>Find resale flips and what to offer</li>
        <li>Write, money, and the next move — by voice</li>
      </ul>
      <div class="dt-mike__actions">
        <a class="dt-mike__cta" href="https://doertoughmikeai.com" target="_blank" rel="noopener">
          Talk to Mike
          <span class="dt-mike__arrow" aria-hidden="true">&rarr;</span>
        </a>
        <p class="dt-mike__foot">Free to start. Opens in a new tab.</p>
      </div>
    </div>

    <aside class="dt-mike__panel" aria-hidden="true">
      <div class="dt-mike__orb" role="presentation">
        <span class="dt-mike__d">D</span><span class="dt-mike__t">T</span>
        <span class="dt-mike__mike">MIKE</span>
      </div>
      <ol class="dt-mike__steps">
        <li><b>Talk</b><span>Tap the mic. Say the deal.</span></li>
        <li><b>Type</b><span>Paste a listing or ask a question.</span></li>
        <li><b>Move</b><span>Walk with a number, not a guess.</span></li>
      </ol>
    </aside>
  </div>
</section>

<style>
  #dt-mike-promo.dt-mike {
    --mike-orange: #ff7611;
    --mike-cyan: #27a9ff;
    background: #191c21;
    color: #fff;
    padding: 64px 20px;
  }
  #dt-mike-promo .dt-mike__inner {
    width: min(1100px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.9fr);
    gap: 40px 56px;
    align-items: center;
  }
  #dt-mike-promo .dt-mike__eyebrow {
    margin: 0 0 10px;
    font-size: 12px;
    letter-spacing: .18em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--mike-orange);
  }
  #dt-mike-promo .dt-mike__heading {
    margin: 0 0 14px;
    font-size: clamp(28px, 4.4vw, 42px);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -.02em;
    font-weight: 800;
    color: #fff;
  }
  #dt-mike-promo .dt-mike__heading span {
    display: block;
    color: var(--mike-orange);
  }
  #dt-mike-promo .dt-mike__body {
    margin: 0 0 18px;
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255,255,255,.78);
    max-width: 48ch;
  }
  #dt-mike-promo .dt-mike__list {
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
  }
  #dt-mike-promo .dt-mike__list li {
    position: relative;
    padding-left: 22px;
    font-size: 15px;
    line-height: 1.5;
    color: rgba(255,255,255,.86);
  }
  #dt-mike-promo .dt-mike__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: .55em;
    width: 10px;
    height: 2px;
    background: var(--mike-orange);
  }
  #dt-mike-promo .dt-mike__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
  }
  #dt-mike-promo .dt-mike__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 14px 28px;
    background: var(--mike-orange);
    color: #14161a;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: .06em;
    text-transform: uppercase;
    text-decoration: none;
    border: 2px solid var(--mike-orange);
    transition: background .15s ease, color .15s ease;
  }
  #dt-mike-promo .dt-mike__cta:hover,
  #dt-mike-promo .dt-mike__cta:focus-visible {
    background: transparent;
    color: var(--mike-orange);
  }
  #dt-mike-promo .dt-mike__cta:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }
  #dt-mike-promo .dt-mike__cta:hover .dt-mike__arrow {
    transform: translateX(3px);
  }
  #dt-mike-promo .dt-mike__arrow {
    display: inline-block;
    transition: transform .15s ease;
  }
  #dt-mike-promo .dt-mike__foot {
    margin: 0;
    font-size: 13px;
    color: rgba(255,255,255,.5);
  }

  #dt-mike-promo .dt-mike__panel {
    display: grid;
    justify-items: center;
    gap: 22px;
    padding: 28px 24px 24px;
    background: #101317;
    border: 1px solid rgba(255,255,255,.12);
    border-left: 4px solid var(--mike-orange);
  }
  #dt-mike-promo .dt-mike__orb {
    width: 132px;
    height: 132px;
    border-radius: 50%;
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    justify-content: center;
    background: radial-gradient(circle at 50% 38%, #1a2026 0%, #0a0e12 70%);
    box-shadow: 0 0 0 5px var(--mike-orange), 0 0 28px rgba(255,118,17,.35);
    font-family: "Arial Black", Arial, sans-serif;
    line-height: .82;
  }
  #dt-mike-promo .dt-mike__d,
  #dt-mike-promo .dt-mike__t {
    font-size: 42px;
    font-weight: 900;
    letter-spacing: -.08em;
  }
  #dt-mike-promo .dt-mike__d { color: #fff; }
  #dt-mike-promo .dt-mike__t { color: var(--mike-orange); }
  #dt-mike-promo .dt-mike__mike {
    flex: 0 0 100%;
    margin-top: 4px;
    text-align: center;
    font-family: Inter, system-ui, sans-serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .28em;
    color: var(--mike-cyan);
  }
  #dt-mike-promo .dt-mike__steps {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }
  #dt-mike-promo .dt-mike__steps li {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 10px;
    align-items: baseline;
    padding-top: 10px;
    border-top: 1px solid rgba(255,255,255,.1);
  }
  #dt-mike-promo .dt-mike__steps li:first-child { border-top: 0; padding-top: 0; }
  #dt-mike-promo .dt-mike__steps b {
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--mike-orange);
  }
  #dt-mike-promo .dt-mike__steps span {
    font-size: 14px;
    line-height: 1.35;
    color: rgba(255,255,255,.82);
  }

  @media (max-width: 820px) {
    #dt-mike-promo.dt-mike { padding: 40px 16px; }
    #dt-mike-promo .dt-mike__inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    #dt-mike-promo .dt-mike__heading span { display: inline; }
    #dt-mike-promo .dt-mike__actions {
      flex-direction: column;
      align-items: stretch;
    }
    #dt-mike-promo .dt-mike__cta { width: 100%; }
    #dt-mike-promo .dt-mike__foot { text-align: center; }
    #dt-mike-promo .dt-mike__panel {
      padding: 20px 16px 16px;
    }
    #dt-mike-promo .dt-mike__orb {
      width: 108px;
      height: 108px;
    }
    #dt-mike-promo .dt-mike__d,
    #dt-mike-promo .dt-mike__t { font-size: 34px; }
    #dt-mike-promo .dt-mike__steps {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 420px) {
    #dt-mike-promo .dt-mike__steps li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #dt-mike-promo .dt-mike__cta,
    #dt-mike-promo .dt-mike__arrow { transition: none; }
  }
</style>
