{% comment %}
  Doer Tough homepage — Mike AI promo.
  Replaces the DealTough (dt_dealtough) section.
  Paste this block into a Custom liquid section, then hide/remove DealTough.
{% endcomment %}

<section class="dt-dtp" id="dt-mike-promo">
  <div class="dt-dtp__inner">
    <div class="dt-dtp__copy">
      <p class="dt-dtp__eyebrow">Also from Doer Tough</p>
      <h2 class="dt-dtp__heading">Talk. Type. Get the next move.</h2>
      <p class="dt-dtp__body">Mike AI is the Doer Tough assistant. Voice or text — analyze a deal, find a flip, write it, or run the next money move. Same grit as the gear.</p>
      <ul class="dt-dtp__list">
        <li>Analyze a used-item deal from a photo or a listing</li>
        <li>Find resale flips and what to offer</li>
        <li>Write, money, and the next move — by voice</li>
      </ul>
      <a
        class="dt-dtp__cta"
        href="https://doertoughmikeai.com"
        target="_blank"
        rel="noopener">
        Talk to Mike
        <span class="dt-dtp__arrow" aria-hidden="true">&rarr;</span>
      </a>
      <p class="dt-dtp__foot">Free to start. Opens doertoughmikeai.com in a new tab.</p>
    </div>

    <div class="dt-dtp__panel" aria-hidden="true">
      <div class="dt-dtp__ticket">
        <span class="dt-dtp__ticket-label">Ready</span>
        <span class="dt-dtp__ticket-strike">tap to talk</span>
        <span class="dt-dtp__ticket-label">Ask</span>
        <span class="dt-dtp__ticket-big">analyze this deal</span>
        <span class="dt-dtp__ticket-label">Next</span>
        <span class="dt-dtp__ticket-walk">get the move</span>
      </div>
    </div>
  </div>
</section>
